generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Campus {
  MAIN
  WEST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(ADMIN)
  campus        Campus?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  reviews  Application[]

  @@map("users")
}

model Account {
  id           String   @id @default(cuid())
  accountId    String
  providerId   String
  userId       String
  accessToken  String?
  refreshToken String?
  idToken      String?
  password     String?
  expiresAt    Int?
  type         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, providerId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model FeeStructure {
  id        String   @id @default(cuid())
  name      String   // display name, e.g. "Diploma Fee Structure 2026"
  url       String?  // PDF file URL (legacy — kept for backward compat)
  pdfData   Bytes?   // PDF stored directly in DB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]

  @@map("fee_structures")
}

model Course {
  id             String       @id @default(cuid())
  name           String       @unique
  department     String?      // e.g. "ICT", "Business", "Hospitality"
  minGrade       String       // minimum education qualification required, e.g. "C+"
  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("courses")
}

model CampusSetting {
  id                  String   @id @default(cuid())
  campus              Campus   @unique
  settings            Json     @default("{}")
  admissionFormat     String   @default("")
  admissionStart      Int      @default(1)
  lastAdmissionNumber Int      @default(0)
  reportingDates      Json     @default("[]")
  bursaryFormPdf      Bytes?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("campus_settings")
}

model Student {
  id              String             @id @default(cuid())
  firstName       String
  middleName      String?
  lastName        String
  gender          Gender?
  phone           String?
  email           String?            @unique
  educationQualification String? @default("")
  preferredCampus Campus?
  status          ApplicationStatus  @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  applications Application[]

  @@map("students")
}

model Application {
  id           String             @id @default(cuid())
  studentId    String
  course       String
  status       ApplicationStatus  @default(PENDING)
  reviewedBy   String?
  notes        String?
  reportingReminderSentAt DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewer User?   @relation(fields: [reviewedBy], references: [id])

  @@map("applications")
}

model AdmissionPdfTemplate {
  id        String   @id @default(cuid())
  name      String
  pdfData   Bytes
  mimeType  String   @default("application/pdf")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admission_pdf_templates")
}

model WhatsAppSession {
  id          String   @id @default(uuid())
  campus      Campus   @unique
  phoneNumber String?  // connected WhatsApp phone number (e.g. 254712345678)
  sessionData String?  // encrypted JSON { creds, keys }
  qrCode      String?  // raw QR string from Baileys
  qrDataUrl   String?  // data URL for display
  status      String   @default("disconnected") // disconnected | waiting_qr | connected
  lastActive  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("whatsapp_sessions")
}

model ReportingPeriod {
  id        String   @id @default(cuid())
  year      Int
  month     Int      // 1-12
  campus    Campus?
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month, campus])
  @@map("reporting_periods")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  email     String
  role      String
  ipAddress String?
  userAgent String?
  status    String   @default("success") // success | failed
  error     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("login_logs")
}

model NotificationJob {
  id          String   @id @default(cuid())
  studentId   String
  studentName String
  course      String
  campus      Campus
  status      String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  lastError   String?
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@map("notification_jobs")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  email     String
  role      String
  campus    String?
  action    String   // e.g. "student.approve", "student.reject", "student.delete", "pdf.upload", "pdf.delete", "bursary.upload", "bursary.delete", "settings.update", "email.change", "course.create", "course.update", "course.delete", "fee.create", "fee.update", "fee.delete", "seed.run", "backup.import"
  target    String   // what was acted on (student ID, course name, etc.)
  detail    String?  // extra context (JSON string)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
